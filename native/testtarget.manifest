<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="x4cockpit3.testtarget" version="0.1.0.0" processorArchitecture="amd64"/>
  <description>x4cockpit3 test target (imitates the X4 window)</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security><requestedPrivileges><requestedExecutionLevel level="asInvoker" uiAccess="false"/></requestedPrivileges></security>
  </trustInfo>
  <!-- same DPI declaration as X4.exe 9.00 (read from its manifest with peimports.py): per-monitor aware v1 -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings><dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">True/PM</dpiAware></windowsSettings>
  </application>
</assembly>
